      "maxLength": 300,
      "minLength": 1,
      "title": "Actor Identity",
      "type": "string"
    },
    "candidate_limit": {
      "default": 50,
      "exclusiveMinimum": 0,
      "maximum": 10000,
      "title": "Candidate Limit",
      "type": "integer"
