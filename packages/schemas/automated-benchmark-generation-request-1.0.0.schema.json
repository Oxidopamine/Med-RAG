    "development_benchmark_id": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Development Benchmark Id",
      "type": "string"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "generation_id": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Generation Id",
      "type": "string"
    },
    "holdout_benchmark_id": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Holdout Benchmark Id",
