{
  "$defs": {
    "RRFWeights": {
      "additionalProperties": false,
      "properties": {
        "dense": {
          "default": 1.0,
          "minimum": 0,
          "title": "Dense",
          "type": "number"
        },
        "sparse": {
          "default": 1.0,
          "minimum": 0,
          "title": "Sparse",
          "type": "number"
        }
      },
      "title": "RRFWeights",
      "type": "object"
    },
    "RetrievalMode": {
      "enum": [
        "sparse",
        "dense",
        "hybrid"
      ],
      "title": "RetrievalMode",
      "type": "string"
    }
  },
