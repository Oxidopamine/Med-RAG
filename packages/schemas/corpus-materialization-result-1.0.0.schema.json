        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "evidence_entries": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ],
            "type": "array"
          },
          "minItems": 1,
          "title": "Evidence Entries",
          "type": "array"
        },
        "materialization_report_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Materialization Report Sha256",
          "type": "string"
        },
        "materialization_run_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Materialization Run Id",
          "type": "string"
        },
        "qa_required": {
          "const": true,
          "default": true,
          "title": "Qa Required",
          "type": "boolean"
        },
        "reconciliation_candidate_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Reconciliation Candidate Id",
          "type": "string"
        },
        "retrieval_eligible": {
          "const": false,
          "default": false,
          "title": "Retrieval Eligible",
          "type": "boolean"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "trust_root_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Trust Root Sha256",
          "type": "string"
        }
      },
      "required": [
        "corpus_release_candidate_id",
        "reconciliation_candidate_id",
        "materialization_run_id",
        "trust_root_sha256",
        "materialization_report_sha256",
        "authority_binding_sha256",
        "evidence_entries",
        "created_at"
      ],
      "title": "CorpusReleaseCandidateContent",
      "type": "object"
    },
    "EvidenceCoverageReport": {
      "additionalProperties": false,
      "properties": {
        "assets": {
          "items": {
            "$ref": "#/$defs/AssetCoverage"
          },
          "minItems": 1,
          "title": "Assets",
          "type": "array"
        },
        "authority_binding_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Authority Binding Sha256",
          "type": "string"
        },
        "complete": {
          "title": "Complete",
          "type": "boolean"
        },
        "evidence_count": {
          "minimum": 0,
          "title": "Evidence Count",
          "type": "integer"
        },
        "expected_asset_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Expected Asset Ids",
          "type": "array"
        }
      },
      "required": [
        "authority_binding_sha256",
        "assets",
        "expected_asset_ids",
        "evidence_count",
        "complete"
      ],
      "title": "EvidenceCoverageReport",
      "type": "object"
    },
    "LicensedAssetKind": {
      "enum": [
        "INVENTORY_SOURCE",
        "NARRATIVE_SOURCE",
        "DEPENDENCY_SOURCE"
      ],
      "title": "LicensedAssetKind",
      "type": "string"
    },
    "LocatorKind": {
      "enum": [
        "TEXT_SPAN",
        "PDF",
        "HTML",
        "XML",
        "FHIR",
        "TABLE_CELL"
      ],
      "title": "LocatorKind",
      "type": "string"
    },
    "MaterializationReport": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "$ref": "#/$defs/MaterializationReportContent"
        },
        "report_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Report Sha256",
          "type": "string"
        }
      },
      "required": [
        "content",
        "report_sha256"
      ],
      "title": "MaterializationReport",
      "type": "object"
    },
    "MaterializationReportContent": {
      "additionalProperties": false,
      "properties": {
        "authority_binding": {
          "anyOf": [
            {
              "$ref": "#/$defs/SignedAuthorityBinding"
            },
            {
              "$ref": "#/$defs/SignedNarrativeAuthorityBinding"
            }
          ],
          "title": "Authority Binding"
        },
        "blockers": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Blockers",
          "type": "array"
        },
        "completed_at": {
          "format": "date-time",
          "title": "Completed At",
          "type": "string"
        },
        "coverage": {
          "$ref": "#/$defs/EvidenceCoverageReport"
        },
        "evidence": {
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/MaterializedEvidenceArtifactEntry"
              },
              {
                "$ref": "#/$defs/MaterializedEvidenceRecord"
              }
            ]
          },
          "title": "Evidence",
          "type": "array"
        },
        "materialization_run_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Materialization Run Id",
          "type": "string"
        },
        "materializer_name": {
          "default": "authority-evidence-materializer",
          "enum": [
            "authority-evidence-materializer",
            "narrative-evidence-materializer"
          ],
          "title": "Materializer Name",
          "type": "string"
        },
        "materializer_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Materializer Version",
          "type": "string"
        },
        "ready_for_qa": {
          "title": "Ready For Qa",
          "type": "boolean"
        },
        "reconciliation_candidate_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Reconciliation Candidate Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "structural_mapping": {
          "anyOf": [
            {
              "$ref": "#/$defs/StructuralMappingAttachment"
            },
            {
              "$ref": "#/$defs/NarrativeAnalysisAttachment"
            }
          ],
          "title": "Structural Mapping"
        }
      },
      "required": [
        "materialization_run_id",
        "reconciliation_candidate_id",
        "authority_binding",
        "structural_mapping",
        "evidence",
        "coverage",
        "completed_at",
        "ready_for_qa"
      ],
      "title": "MaterializationReportContent",
      "type": "object"
    },
    "MaterializationState": {
      "enum": [
        "READY_FOR_QA",
        "BLOCKED"
      ],
      "title": "MaterializationState",
      "type": "string"
    },
    "MaterializedEvidenceArtifactEntry": {
      "additionalProperties": false,
      "description": "Compact report entry; full evidence lives in its content-addressed artifact.",
      "properties": {
        "artifact_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Artifact Sha256",
          "type": "string"
        },
        "asset_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Asset Id",
          "type": "string"
        },
        "evidence_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        },
        "evidence_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Evidence Sha256",
          "type": "string"
        },
        "source_artifact_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source Artifact Sha256",
          "type": "string"
        },
        "source_unit_id": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Source Unit Id",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "evidence_sha256",
        "artifact_sha256",
        "source_artifact_sha256",
        "asset_id",
        "source_unit_id"
      ],
      "title": "MaterializedEvidenceArtifactEntry",
      "type": "object"
    },
    "MaterializedEvidenceContent": {
      "additionalProperties": false,
