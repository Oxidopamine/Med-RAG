        "anchors": {
          "items": {
            "$ref": "#/$defs/SourceAnchor"
          },
          "minItems": 1,
          "title": "Anchors",
          "type": "array"
        },
        "asset_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Asset Id",
          "type": "string"
        },
        "authority_binding_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Authority Binding Sha256",
          "type": "string"
        },
        "authority_role": {
          "const": "CONTROLLING_CLINICAL_SOURCE",
          "default": "CONTROLLING_CLINICAL_SOURCE",
          "title": "Authority Role",
          "type": "string"
        },
        "content_exact": {
          "minLength": 1,
          "title": "Content Exact",
          "type": "string"
        },
        "content_search": {
          "minLength": 1,
          "title": "Content Search",
          "type": "string"
        },
        "evidence_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        },
        "jurisdiction": {
          "maxLength": 32,
          "minLength": 1,
          "title": "Jurisdiction",
          "type": "string"
        },
        "language": {
          "maxLength": 20,
          "minLength": 2,
          "title": "Language",
          "type": "string"
        },
        "lifecycle_status": {
          "$ref": "#/$defs/SourceStatus"
        },
        "materialization_run_id": {
          "maxLength": 64,
          "minLength": 1,
