        }
      },
      "required": [
        "materialization_run_id",
        "evidence_id",
        "authority_binding_sha256",
        "asset_id",
        "source_artifact_sha256",
        "source_unit_id",
        "source_title",
        "source_version_id",
        "publisher_id",
        "jurisdiction",
        "language",
        "lifecycle_status",
        "content_exact",
        "content_search",
        "anchors",
        "render_allowed"
