{
  "$defs": {
    "AssetCoverage": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "minLength": 1,
          "title": "Asset Id",
          "type": "string"
        },
        "complete": {
          "title": "Complete",
          "type": "boolean"
        },
        "empty_source_units": {
          "minimum": 0,
          "title": "Empty Source Units",
          "type": "integer"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "expected_source_units": {
          "minimum": 1,
          "title": "Expected Source Units",
          "type": "integer"
        },
        "materialized_source_units": {
          "minimum": 0,
          "title": "Materialized Source Units",
          "type": "integer"
        },
        "source_artifact_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source Artifact Sha256",
          "type": "string"
        }
      },
      "required": [
        "asset_id",
        "source_artifact_sha256",
        "expected_source_units",
        "materialized_source_units",
        "empty_source_units",
        "evidence_ids",
        "complete"
      ],
      "title": "AssetCoverage",
      "type": "object"
    },
    "AssetLicensingPolicy": {
      "additionalProperties": false,
      "description": "License and permitted processing operations for one logical source asset.",
      "properties": {
        "acquisition_allowed": {
          "title": "Acquisition Allowed",
          "type": "boolean"
        },
        "asset_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Asset Id",
          "type": "string"
        },
        "asset_kind": {
          "$ref": "#/$defs/LicensedAssetKind"
        },
        "credential_reference": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Credential Reference"
        },
        "evidence_materialization_allowed": {
          "default": false,
          "title": "Evidence Materialization Allowed",
          "type": "boolean"
        },
        "license_id": {
          "minLength": 1,
          "title": "License Id",
          "type": "string"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "policy_url": {
          "minLength": 1,
          "title": "Policy Url",
          "type": "string"
        },
        "redistribution_allowed": {
          "default": false,
          "title": "Redistribution Allowed",
          "type": "boolean"
        },
        "render_allowed": {
          "default": false,
          "title": "Render Allowed",
          "type": "boolean"
        },
        "source_declared_license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Declared License Id"
        }
      },
      "required": [
        "license_id",
        "policy_url",
        "acquisition_allowed",
        "asset_id",
        "asset_kind"
      ],
      "title": "AssetLicensingPolicy",
      "type": "object"
    },
    "AttestationPurpose": {
      "enum": [
        "STAGE",
        "EXCEPTION",
        "ACTIVATION"
      ],
      "title": "AttestationPurpose",
      "type": "string"
    },
    "AuthorityAssetBinding": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Asset Id",
          "type": "string"
        },
        "authority_role": {
          "$ref": "#/$defs/AuthorityRole"
        },
        "authorized_use": {
          "$ref": "#/$defs/AuthorizedUse"
        },
        "clinical_content_promotable": {
          "title": "Clinical Content Promotable",
          "type": "boolean"
        },
        "experimental": {
          "default": false,
          "title": "Experimental",
          "type": "boolean"
        },
        "licensing": {
          "$ref": "#/$defs/AssetLicensingPolicy"
        },
        "lifecycle_status": {
          "$ref": "#/$defs/SourceStatus"
        },
        "media_type": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "source_artifact_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source Artifact Sha256",
          "type": "string"
        },
        "source_uri": {
          "minLength": 1,
          "title": "Source Uri",
          "type": "string"
        },
        "title": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "asset_id",
        "title",
        "authority_role",
        "authorized_use",
        "source_artifact_sha256",
        "media_type",
        "source_uri",
        "lifecycle_status",
        "clinical_content_promotable",
        "licensing"
      ],
      "title": "AuthorityAssetBinding",
      "type": "object"
    },
    "AuthorityBindingContent": {
      "additionalProperties": false,
      "properties": {
        "assets": {
          "items": {
            "$ref": "#/$defs/AuthorityAssetBinding"
          },
          "minItems": 2,
          "title": "Assets",
          "type": "array"
        },
        "bound_at": {
          "format": "date-time",
          "title": "Bound At",
          "type": "string"
        },
        "controlling_source_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Controlling Source Id",
          "type": "string"
        },
        "input_closure_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Input Closure Sha256",
          "type": "string"
        },
        "licensing_trust_root_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Licensing Trust Root Sha256",
          "type": "string"
        },
        "materialization_run_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Materialization Run Id",
          "type": "string"
        },
        "reconciliation_candidate_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Reconciliation Candidate Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "structured_companion_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Structured Companion Id",
          "type": "string"
        },
        "structured_report_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Structured Report Sha256",
          "type": "string"
        },
        "trust_root_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Trust Root Id",
          "type": "string"
        },
        "trust_root_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Trust Root Sha256",
          "type": "string"
        }
      },
      "required": [
        "materialization_run_id",
        "reconciliation_candidate_id",
        "trust_root_id",
        "trust_root_sha256",
        "licensing_trust_root_sha256",
        "input_closure_sha256",
        "structured_report_sha256",
        "controlling_source_id",
        "structured_companion_id",
        "assets",
        "bound_at"
      ],
      "title": "AuthorityBindingContent",
      "type": "object"
    },
    "AuthorityRole": {
      "enum": [
        "CONTROLLING_CLINICAL_SOURCE",
        "STRUCTURED_COMPANION"
      ],
      "title": "AuthorityRole",
      "type": "string"
    },
    "AuthorizedUse": {
      "enum": [
        "CLINICAL_EVIDENCE",
        "STRUCTURAL_MAPPING_ONLY"
      ],
      "title": "AuthorizedUse",
      "type": "string"
    },
    "CorpusReleaseCandidateContent": {
      "additionalProperties": false,
      "properties": {
        "authority_binding_sha256": {
          "pattern": "^[a-f0-9]{64}$",
