        },
        "qa_status": {
          "const": "AWAITING_QA",
          "default": "AWAITING_QA",
          "title": "Qa Status",
          "type": "string"
        },
        "render_allowed": {
          "title": "Render Allowed",
          "type": "boolean"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_artifact_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source Artifact Sha256",
          "type": "string"
        },
        "source_title": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Source Title",
          "type": "string"
        },
        "source_unit_id": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Source Unit Id",
          "type": "string"
        },
        "source_version_id": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Source Version Id",
