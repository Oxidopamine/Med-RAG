    "MaterializedEvidenceRecord": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "$ref": "#/$defs/MaterializedEvidenceContent"
        },
        "evidence_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Evidence Sha256",
          "type": "string"
        }
      },
      "required": [
        "content",
        "evidence_sha256"
      ],
      "title": "MaterializedEvidenceRecord",
      "type": "object"
    },
    "NarrativeAnalysisAttachment": {
      "additionalProperties": false,
      "description": "Peer of :class:`StructuralMappingAttachment` for the narrative topology.\n\n``clinical_content_included`` stays ``False``: the narrative source analysis is a\nstructural census of the document, not its text. ``unit_inventory_sha256`` is the prior\nstatement the materializer must recompute from the bytes it extracts and agree with --\nwithout that comparison the attachment is a rubber stamp.",
      "properties": {
        "asset_id": {
          "minLength": 1,
          "title": "Asset Id",
          "type": "string"
        },
        "authorized_use": {
          "const": "CLINICAL_EVIDENCE",
          "default": "CLINICAL_EVIDENCE",
          "title": "Authorized Use",
          "type": "string"
        },
        "clinical_content_included": {
          "const": false,
          "default": false,
          "title": "Clinical Content Included",
          "type": "boolean"
        },
        "declared_license_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Declared License Id"
        },
        "narrative_analysis_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Narrative Analysis Sha256",
          "type": "string"
        },
        "narrative_run_id": {
          "minLength": 1,
          "title": "Narrative Run Id",
          "type": "string"
        },
        "unit_count": {
          "exclusiveMinimum": 0,
          "title": "Unit Count",
          "type": "integer"
        },
        "unit_inventory_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Unit Inventory Sha256",
          "type": "string"
        }
      },
      "required": [
        "asset_id",
        "narrative_run_id",
        "narrative_analysis_sha256",
        "unit_inventory_sha256",
        "unit_count"
      ],
      "title": "NarrativeAnalysisAttachment",
      "type": "object"
    },
    "NarrativeAuthorityBindingContent": {
      "additionalProperties": false,
      "description": "Authority binding for a narrative-anchored publisher, where one artifact is both the\ninventory source and the controlling clinical narrative.\n\nA sibling of :class:`AuthorityBindingContent`, never an extension of it. That model is\nfrozen: its canonical bytes are committed to signed history that can never be re-signed,\nand ``canonical_json_bytes`` serializes even a ``None``-defaulted field. The two members\nare told apart by their disjoint required fields under ``extra=\"forbid\"``.",
      "properties": {
        "assets": {
          "items": {
            "$ref": "#/$defs/AuthorityAssetBinding"
          },
          "minItems": 1,
          "title": "Assets",
          "type": "array"
        },
        "bound_at": {
          "format": "date-time",
          "title": "Bound At",
          "type": "string"
        },
        "controlling_source_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Controlling Source Id",
          "type": "string"
        },
        "input_closure_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Input Closure Sha256",
          "type": "string"
        },
        "licensing_trust_root_sha256": {
          "pattern": "^[a-f0-9]{64}$",
