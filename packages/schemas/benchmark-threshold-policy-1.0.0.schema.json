{
  "$defs": {
    "BenchmarkAcceptance": {
      "additionalProperties": false,
      "description": "Prespecified gates for one benchmark run.\n\nAbsolute score floors are not transferable between corpora: retrieval effectiveness\nvaries more with collection and topic difficulty than with system quality, so a bar\ncopied from a leaderboard measures the corpus rather than the stack. Every gate here\nis therefore expected to be one of three defensible forms - derived from what a\ndownstream consumer actually needs, stated as a confidence bound rather than a point\nestimate, or expressed relative to a named comparator that was measured on this same\nsuite. Ranking-quality metrics that no safety argument depends on are reported rather\nthan gated.",
      "properties": {
        "comparator_answerable_complete_evidence_rate": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Comparator Answerable Complete Evidence Rate"
        },
        "comparator_candidate_id": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Comparator Candidate Id"
        },
        "comparator_report_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Comparator Report Sha256"
        },
        "generation_context_budget": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 1000,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Generation Context Budget"
        },
        "maximum_candidate_failure_cases": {
          "default": 0,
          "minimum": 0,
          "title": "Maximum Candidate Failure Cases",
          "type": "integer"
        },
        "maximum_forbidden_leakage_cases": {
          "default": 0,
          "minimum": 0,
          "title": "Maximum Forbidden Leakage Cases",
          "type": "integer"
        },
        "maximum_p95_latency_ms": {
          "default": 2000.0,
          "exclusiveMinimum": 0,
          "title": "Maximum P95 Latency Ms",
          "type": "number"
        },
        "minimum_answerable_complete_evidence_at_budget_rate": {
          "default": 0.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Minimum Answerable Complete Evidence At Budget Rate",
          "type": "number"
        },
        "minimum_answerable_complete_evidence_set_rate": {
          "default": 0.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Minimum Answerable Complete Evidence Set Rate",
          "type": "number"
        },
        "minimum_answerable_mean_recall_at_k": {
          "default": 0.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Minimum Answerable Mean Recall At K",
          "type": "number"
        },
        "minimum_comparator_margin": {
          "default": 0.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Minimum Comparator Margin",
          "type": "number"
        },
        "minimum_complete_evidence_set_rate": {
          "default": 1.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Minimum Complete Evidence Set Rate",
          "type": "number"
        },
        "minimum_insufficient_evidence_accuracy": {
          "default": 1.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Minimum Insufficient Evidence Accuracy",
          "type": "number"
        },
        "minimum_mean_context_precision_at_k": {
          "default": 0.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Minimum Mean Context Precision At K",
          "type": "number"
        },
        "minimum_mean_ndcg_at_k": {
          "default": 0.8,
          "maximum": 1,
          "minimum": 0,
          "title": "Minimum Mean Ndcg At K",
          "type": "number"
        },
        "minimum_mean_r_precision": {
          "default": 0.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Minimum Mean R Precision",
          "type": "number"
        },
        "minimum_mean_recall_at_k": {
          "default": 0.8,
          "maximum": 1,
          "minimum": 0,
          "title": "Minimum Mean Recall At K",
          "type": "number"
        },
        "minimum_mean_reciprocal_rank": {
          "default": 0.8,
          "maximum": 1,
          "minimum": 0,
          "title": "Minimum Mean Reciprocal Rank",
          "type": "number"
        },
        "minimum_mean_required_role_recall": {
          "default": 1.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Minimum Mean Required Role Recall",
          "type": "number"
        },
        "minimum_naive_comparator_margin": {
          "default": 0.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Minimum Naive Comparator Margin",
          "type": "number"
        },
        "minimum_total_case_count": {
          "default": 1,
          "exclusiveMinimum": 0,
          "title": "Minimum Total Case Count",
          "type": "integer"
        },
        "naive_comparator_answerable_complete_evidence_rate": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Naive Comparator Answerable Complete Evidence Rate"
        },
        "naive_comparator_candidate_id": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Naive Comparator Candidate Id"
        },
        "naive_comparator_report_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Naive Comparator Report Sha256"
        },
        "require_confidence_lower_bound": {
          "default": true,
          "title": "Require Confidence Lower Bound",
          "type": "boolean"
        },
        "safety_strata": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SafetyStratumThreshold"
          },
          "title": "Safety Strata",
          "type": "array"
        }
      },
      "title": "BenchmarkAcceptance",
      "type": "object"
    },
    "BenchmarkThresholdPolicyContent": {
      "additionalProperties": false,
      "properties": {
        "binomial_uncertainty_method": {
          "const": "WILSON_95",
          "default": "WILSON_95",
          "title": "Binomial Uncertainty Method",
          "type": "string"
        },
        "candidates_under_test_unevaluated": {
          "const": true,
          "default": true,
          "title": "Candidates Under Test Unevaluated",
          "type": "boolean"
        },
        "comparator_measured_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Comparator Measured At"
        },
        "development_acceptance": {
          "$ref": "#/$defs/BenchmarkAcceptance"
        },
        "development_minimum_case_count": {
          "exclusiveMinimum": 0,
          "title": "Development Minimum Case Count",
          "type": "integer"
        },
        "established_at": {
          "format": "date-time",
          "title": "Established At",
          "type": "string"
        },
        "minimum_exact_agreement_rate": {
          "default": 0.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Minimum Exact Agreement Rate",
          "type": "number"
        },
        "non_binomial_uncertainty_method": {
          "const": "STRATIFIED_BOOTSTRAP_95",
          "default": "STRATIFIED_BOOTSTRAP_95",
          "title": "Non Binomial Uncertainty Method",
          "type": "string"
        },
        "policy_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Policy Id",
          "type": "string"
        },
        "revision": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        },
        "safety_topic_sample_targets": {
          "items": {
            "$ref": "#/$defs/SafetyTopicSampleTarget"
          },
          "minItems": 1,
          "title": "Safety Topic Sample Targets",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sealed_holdout_acceptance": {
          "$ref": "#/$defs/BenchmarkAcceptance"
        },
        "sealed_holdout_minimum_case_count": {
          "exclusiveMinimum": 0,
          "title": "Sealed Holdout Minimum Case Count",
          "type": "integer"
        },
        "threshold_derivation": {
          "$ref": "#/$defs/ThresholdDerivation"
        }
      },
      "required": [
        "policy_id",
        "revision",
        "development_minimum_case_count",
        "sealed_holdout_minimum_case_count",
        "safety_topic_sample_targets",
        "development_acceptance",
        "sealed_holdout_acceptance",
        "threshold_derivation",
        "established_at"
      ],
      "title": "BenchmarkThresholdPolicyContent",
      "type": "object"
    },
    "ClinicalSafetyTopic": {
      "enum": [
        "CONTRAINDICATION",
        "APPLICABILITY",
        "DOSE",
        "MONITORING",
        "TERMINOLOGY",
        "MULTILINGUAL_CROSS_LINGUAL",
        "STALE_SOURCE",
        "WRONG_JURISDICTION",
        "CONFLICTING_EVIDENCE",
        "INSUFFICIENT_EVIDENCE",
        "NEGATION",
        "PARAPHRASED_INTENT"
      ],
      "title": "ClinicalSafetyTopic",
      "type": "string"
    },
    "SafetyStratumThreshold": {
      "additionalProperties": false,
      "properties": {
        "maximum_forbidden_leakage_cases": {
          "default": 0,
          "minimum": 0,
          "title": "Maximum Forbidden Leakage Cases",
          "type": "integer"
        },
        "minimum_case_count": {
          "default": 1,
          "exclusiveMinimum": 0,
          "title": "Minimum Case Count",
          "type": "integer"
        },
        "minimum_complete_evidence_set_rate": {
          "default": 0.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Minimum Complete Evidence Set Rate",
          "type": "number"
        },
        "minimum_insufficient_evidence_accuracy": {
          "default": 0.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Minimum Insufficient Evidence Accuracy",
          "type": "number"
        },
        "minimum_mean_recall_at_k": {
          "default": 0.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Minimum Mean Recall At K",
          "type": "number"
        },
        "minimum_mean_required_role_recall": {
          "default": 0.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Minimum Mean Required Role Recall",
          "type": "number"
        },
        "stratum_key": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Stratum Key",
          "type": "string"
        },
        "stratum_value": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Stratum Value",
          "type": "string"
        }
      },
      "required": [
        "stratum_key",
        "stratum_value"
      ],
      "title": "SafetyStratumThreshold",
      "type": "object"
    },
    "SafetyTopicSampleTarget": {
      "additionalProperties": false,
      "properties": {
        "development_minimum": {
          "exclusiveMinimum": 0,
          "title": "Development Minimum",
          "type": "integer"
        },
        "safety_topic": {
          "$ref": "#/$defs/ClinicalSafetyTopic"
        },
        "sealed_holdout_minimum": {
          "exclusiveMinimum": 0,
          "title": "Sealed Holdout Minimum",
          "type": "integer"
        }
      },
      "required": [
        "safety_topic",
        "development_minimum",
        "sealed_holdout_minimum"
      ],
      "title": "SafetyTopicSampleTarget",
      "type": "object"
    },
    "ThresholdDerivation": {
      "description": "How the numeric gates in this policy were arrived at.\n\nThe distinction is not cosmetic. ``PRESPECIFIED_ABSOLUTE`` asserts that no\nmeasurement informed the numbers, which is the strong pre-registration claim.\n``COMPARATOR_WILSON_95_LOWER_BOUND`` asserts something weaker and different: the\ngates are the Wilson-95 lower bounds of a comparator that was measured on this same\nsuite, so they are posterior quantities and the policy is a non-inferiority design\nrather than an absolute one. Recording the weaker claim as the stronger one would\nmake the sealed artifact misdescribe its own provenance.",
      "enum": [
        "PRESPECIFIED_ABSOLUTE",
        "CONSUMER_REQUIREMENT",
        "COMPARATOR_WILSON_95_LOWER_BOUND"
      ],
      "title": "ThresholdDerivation",
      "type": "string"
    }
  },
  "$id": "https://med-rag.local/contracts/benchmark-threshold-policy-1.0.0.schema.json",
  "additionalProperties": false,
  "properties": {
    "content": {
      "$ref": "#/$defs/BenchmarkThresholdPolicyContent"
    },
    "policy_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Policy Sha256",
      "type": "string"
    }
  },
  "required": [
    "content",
    "policy_sha256"
  ],
  "title": "BenchmarkThresholdPolicy",
  "type": "object",
  "x-contract-version": "1.0.0"
}
