# Research profile only. Do not use this stack for PHI or patient care.
DATABASE_URL=postgresql+asyncpg://medrag:medrag@localhost:5432/medrag
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=replace-for-authenticated-qdrant
QDRANT_TIMEOUT_SECONDS=60
QDRANT_EXPECTED_VERSION=1.15.4
API_CORS_ORIGINS=["http://localhost:3000"]
API_CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1):[0-9]+$
NEXT_PUBLIC_API_URL=http://localhost:8000
ENVIRONMENT=development
SAFETY_POLICY_VERSION=0.1.0
INGESTION_API_KEY=replace-with-at-least-24-random-characters
ARTIFACT_STORE_PATH=data/local/artifacts
INGESTION_MAX_PDF_BYTES=52428800
INGESTION_REQUEST_TIMEOUT_SECONDS=30
INGESTION_ALLOW_PRIVATE_NETWORKS=false
STEWARD_ARTIFACT_STORE_PATH=data/local/steward-artifacts
STEWARD_MAX_ARTIFACT_BYTES=104857600
STEWARD_REQUEST_TIMEOUT_SECONDS=60
STEWARD_ALLOW_PRIVATE_NETWORKS=false
STEWARD_FHIR_MAX_ENTRIES=10000
STEWARD_FHIR_MAX_TOTAL_UNCOMPRESSED_BYTES=536870912
STEWARD_FHIR_MAX_MEMBER_BYTES=33554432
STEWARD_FHIR_MAX_COMPRESSION_RATIO=100
STEWARD_FHIR_MAX_JSON_DEPTH=100
# Configure these only for the separate build-side process, never the serving API.
# CORPUS_STEWARD_SIGNING_KEY_PATH=secrets/steward-stage-private.pem
# CORPUS_STEWARD_SIGNING_KEY_ID=local-stage-key
# CORPUS_STEWARD_SIGNER_IDENTITY=local-corpus-steward

# Grounded answer lane. Google Vertex AI is the selected platform; authentication is GCP
# application-default credentials (`gcloud auth application-default login`), not an API
# key, so no secret belongs in this file. Vertex model IDs take no prefix. There is no
# default project: guessing one would silently bill the wrong account.
# MEDRAG_VERTEX_PROJECT_ID=replace-with-gcp-project-id
# MEDRAG_VERTEX_REGION=global
# MEDRAG_GENERATION_MODEL_ID=claude-opus-5
# MEDRAG_GENERATION_MAX_TOKENS=16000
# MEDRAG_GENERATION_EFFORT=high
