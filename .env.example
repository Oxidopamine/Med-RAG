# Research profile only. Do not use this stack for PHI or patient care.
DATABASE_URL=postgresql+asyncpg://medrag:medrag@localhost:5432/medrag
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=replace-for-authenticated-qdrant
QDRANT_TIMEOUT_SECONDS=60
QDRANT_EXPECTED_VERSION=1.15.4
API_CORS_ORIGINS=["http://localhost:3000"]
API_CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1):[0-9]+$
NEXT_PUBLIC_API_URL=http://localhost:8000
ENVIRONMENT=development
SAFETY_POLICY_VERSION=0.1.0
INGESTION_API_KEY=replace-with-at-least-24-random-characters
ARTIFACT_STORE_PATH=data/local/artifacts
INGESTION_MAX_PDF_BYTES=52428800
INGESTION_REQUEST_TIMEOUT_SECONDS=30
INGESTION_ALLOW_PRIVATE_NETWORKS=false
STEWARD_ARTIFACT_STORE_PATH=data/local/steward-artifacts
STEWARD_MAX_ARTIFACT_BYTES=104857600
STEWARD_REQUEST_TIMEOUT_SECONDS=60
STEWARD_ALLOW_PRIVATE_NETWORKS=false
STEWARD_FHIR_MAX_ENTRIES=10000
STEWARD_FHIR_MAX_TOTAL_UNCOMPRESSED_BYTES=536870912
STEWARD_FHIR_MAX_MEMBER_BYTES=33554432
STEWARD_FHIR_MAX_COMPRESSION_RATIO=100
STEWARD_FHIR_MAX_JSON_DEPTH=100
# Configure these only for the separate build-side process, never the serving API.
# CORPUS_STEWARD_SIGNING_KEY_PATH=secrets/steward-stage-private.pem
# CORPUS_STEWARD_SIGNING_KEY_ID=local-stage-key
# CORPUS_STEWARD_SIGNER_IDENTITY=local-corpus-steward

# Grounded answer lane. Google Vertex AI is the selected platform; authentication is GCP
# application-default credentials (`gcloud auth application-default login`), not an API
# key, so no secret belongs in this file. Vertex model IDs take no prefix. There is no
# default project: guessing one would silently bill the wrong account.
# MEDRAG_VERTEX_PROJECT_ID=replace-with-gcp-project-id
# MEDRAG_VERTEX_REGION=global
# MEDRAG_GENERATION_MODEL_ID=claude-opus-5
# MEDRAG_GENERATION_MAX_TOKENS=16000
# MEDRAG_GENERATION_EFFORT=high

# Development comparator, selected with `--generation-provider gemini`. Reached through
# Vertex on the same project and the same credentials, so it introduces no API key
# either. Pin an explicit version: `gemini-flash-latest` is a floating alias, and the
# first two stage-1 runs recorded no model ID at all, so what produced their numbers is
# not recoverable. Any run that backs a recorded number sets this explicitly.
# MEDRAG_GEMINI_MODEL_ID=gemini-3.7-flash
# MEDRAG_GEMINI_TEMPERATURE=0.0
# MEDRAG_GEMINI_SEED=20260827

# Research serving path. Off by default; the API then abstains with
# RETRIEVAL_PIPELINE_NOT_CONFIGURED, which accurately describes that deployment.
#
# Enabling it serves a VALIDATED release WITHOUT activating it. Activation is a signed
# gate backed by a sealed-holdout acceptance record and nothing here forges one: the
# singleton pointer stays empty and every answer is labelled RESEARCH_UNACTIVATED, which
# the workspace renders as "Research serving - not clinically accepted". It also loads
# the embedding model in-process, roughly 5.4 GiB resident for Qwen3-0.6B on CPU/fp32.
#
# SERVING_ENABLED=true
# SERVING_RELEASE_BUNDLE_PATH=data/local/validated-who-smart-hiv-release.json
# SERVING_VECTORS_PATH=data/local/benchmark-source-derived/qwen3-0.6b-release-vectors.json
# Name the collection for the vector profile actually being served: a release indexed
# under several profiles has one collection each, and the manifest names only the first.
# SERVING_QDRANT_COLLECTION=corpus_cr_<release>--vp-<profile>
# SERVING_EMBEDDING_BACKEND=verified-local
# SERVING_DENSE_MODEL_ROOT=models/local/qwen3-embedding-0.6b
# SERVING_DENSE_MODEL_MANIFEST=data/local/model-manifests/qwen3-embedding-0.6b-cpu-float32.json
# SERVING_DENSE_ARTIFACT_SHA256=<digest>
# SERVING_SPARSE_MODEL_ROOT=models/artifacts/qdrant-bm25-unicode-v1
# SERVING_SPARSE_MODEL_MANIFEST=data/local/model-manifests/qdrant-bm25-who-smart-hiv-v1.json
# SERVING_SPARSE_ARTIFACT_SHA256=<digest>
# claude is the intended production lane; gemini is the comparator while the anthropic-*
# Vertex quota is ungranted. Either needs MEDRAG_VERTEX_PROJECT_ID and ADC above.
# SERVING_GENERATION_PROVIDER=gemini
