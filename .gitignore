.env
.env.local
.vscode/
# Agent worktrees. These are full checkouts of this repo on other branches, so
# leaving them untracked is not enough - `find`, ripgrep and test collection all
# walk into them and report duplicate source trees.
.claude/
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
node_modules/
.next/
.next-e2e/
# Regenerated by every `next dev` / `next build`, with `import`s pointing at whichever
# distDir that command used - so a tracked copy flips between `.next` and `.next-e2e`
# depending on who ran what last, and the committed version referenced a build directory
# that is itself ignored (a fresh clone typechecked against imports that did not exist).
# Nothing needs it checked in: `tsc --noEmit` passes without it, and Next writes it back
# on the next dev or build.
apps/web/next-env.d.ts
*.tsbuildinfo
out/
dist/
coverage/
playwright-report/
# Screenshots written by ad-hoc Playwright runs used to eyeball a component.
*-viewer-*.png
test-results/
data/local/
models/local/
*.log
.logs/
.DS_Store
apps/api/build/

# Backups of .env made by hand before a branch switch; they carry live credentials.
.env.bak*
.env.*.bak
# Agent-instruction files that `next dev` regenerates. They are tooling scaffolding, not
# project documentation, and are not tracked.
apps/web/AGENTS.md
apps/web/CLAUDE.md
# Content-addressed steward artifacts written under the API package during local runs.
apps/api/data/local/
