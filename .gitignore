.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
node_modules/
.next/
.next-e2e/
*.tsbuildinfo
out/
dist/
coverage/
playwright-report/
# Screenshots written by ad-hoc Playwright runs used to eyeball a component.
*-viewer-*.png
test-results/
data/local/
models/local/
*.log
.logs/
.DS_Store
apps/api/build/
